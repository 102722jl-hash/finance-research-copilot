# ══════════════════════════════════════════════════════════════
# 火山方舟（Volcano ARK）云端部署配置模板 —— 已按 2026-10-16 实测校准
#
# 用法：把本文件内容复制/覆盖到同目录的 .env，然后填 2 个值：
#   ① LLM_API_KEY / EMBED_API_KEY = 你的火山方舟 API Key（两处一样）
#   ② DB_PASSWORD = 云端 MySQL 密码（宝塔「数据库」页里看）
#
# ⚠️ 前提：火山方舟控制台已开通
#   · 对话模型   doubao-seed-2-0-mini-260428
#   · 向量模型   doubao-embedding-vision-251215（多模态向量，走 /embeddings/multimodal）
# ══════════════════════════════════════════════════════════════

# ── 聊天 ──
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=请填你的火山方舟 API Key
LLM_MODEL=doubao-seed-2-0-mini-260428
# 火山不认 reasoning_effort → 留空
LLM_REASONING_EFFORT=
# 关掉深度思考（实测该模型接受此参数；不关的话单次调用可能几十秒、会撞 45s 超时）
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# ── 向量（火山方舟的多模态向量模型）──
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_API_KEY=请填你的火山方舟 API Key
EMBED_MODEL=doubao-embedding-vision-251215
# 说明：代码按模型名自动识别 —— 名字含 "vision" 就走 /embeddings/multimodal 专用适配器
#      （实测：纯文本风格的 /embeddings 会 400 "does not support this api"）。
# 可选降维（默认原生 2048 维）：EMBED_DIMENSIONS=1024

# ── 重排 rerank（2026-10-19 起：改走硅基流动，OpenAI 兼容）──
# 🔴 火山方舟**接不了** rerank，原因是三处结构差异（实测）：
#    ① 主机不同：知识库在 api-knowledgebase.mlp.cn-beijing.volces.com，
#       不在 ark.cn-beijing.volces.com（实测 4 个候选路径全 404）
#    ② 鉴权不同：要 HMAC-SHA256 AK/SK 签名；用 API Key 发 Bearer → 403 check sign error
#    ③ 请求/响应不同：{rerank_model, datas:[{query,content}]} → {data:{scores:[]}}，没有 index
# ⇒ 换硅基流动：同一个 bge-reranker-v2-m3 模型，OpenAI 兼容格式，**免费档**（官方定价页）。
#   去 https://cloud.siliconflow.cn 注册 → API 密钥页建 key → 填下面 RERANK_API_KEY。
#   免费档有限速；真被限流了再换 Pro/... （¥0.07/百万 tokens，一次检索约 ¥0.0009）。
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=请填你的硅基流动 API Key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# 单次 rerank 超时（秒）。失败会自动降级为「融合」顺序，不会让查公告挂掉。
RERANK_TIMEOUT=8

# 检索方式：融合重排 = 向量 + BM25 融合后再精排（rerank 可用时才这么设）
RETRIEVAL_MODE=融合重排

# ── MySQL（云端 workspace 库）──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=workspace
DB_PASSWORD=请填云端 MySQL 密码

# ── 网页搜索（Tavily）──
TAVILY_API_KEY=请填你的 Tavily Key

# ── MCP ──
MCP_ENABLED=1
MCP_BOOT_TIMEOUT=120
MCP_TOOL_TIMEOUT=60
