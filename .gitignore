# ══════════════════════════════════════════════════════════
#  .gitignore  —  2026-10-21 重写（原版有两条规则被行内注释弄失效）
# ══════════════════════════════════════════════════════════

# ── 本地密钥 / 真实凭据 —— 绝不提交 ──
.env
.env.bak-*
env_火山_服务器用.txt

# ── 模板（占位符，可提交）──
!.env.example
!.env.volcano.example

# ── Python ──
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# ── 向量库 / 索引产物（可由 重建向量库.py 重生成）──
rag_store/
schema_store/
chroma_db/

# ── 运行日志（start_local.py 每次启动都会写）──
run.out.log
run.err.log
mysql.console.log

# ── 系统 ──
Thumbs.db
desktop.ini
.DS_Store
