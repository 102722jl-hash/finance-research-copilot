# 复制本文件为 .env 后填写（.env 不要提交）

# ── LLM（OpenAI 兼容端点）──
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 关思考开关（可选）：部分厂商认 reasoning_effort=none，不认就留空
LLM_REASONING_EFFORT=
# 通用 extra_body（JSON，可选）：原样透传给模型
#   火山方舟关思考：{"thinking": {"type": "disabled"}}
LLM_EXTRA_BODY=

# ── 检索方式（可选）：向量 | BM25 | 融合 | 融合重排 ──
# 默认 融合重排；换厂商后 rerank 接口不兼容时改成 融合 即可跳过重排
RETRIEVAL_MODE=

# ── 向量 / 重排（可选；不填就沿用上面的 LLM_*）──
# 换厂商时若模型名不同，在这里覆盖（例：硅基流动）
# EMBED_BASE_URL=https://api.siliconflow.cn/v1
# EMBED_API_KEY=
# EMBED_MODEL=BAAI/bge-large-zh-v1.5
# RERANK_BASE_URL=https://api.siliconflow.cn/v1
# RERANK_API_KEY=
# RERANK_MODEL=BAAI/bge-reranker-large

# ── MySQL（本机 workspace 库）──
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_NAME=workspace
DB_PASSWORD=
# 也认 MYSQL_PWD 这个你常用的环境变量
